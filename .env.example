# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API / connect via Socket.IO
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
# Used once, only to seed the first row of the `admins` table if it's still
# empty (see adminService.ensureBootstrapAdmin()). Every login after that
# checks the `admins` table (bcrypt-hashed), not these two vars — add more
# staff from the dashboard's Manage Staff screen instead of sharing this one.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Postgres ---
# Render Postgres gives you this connection string directly.
DATABASE_URL=postgres://user:password@localhost:5432/mopdatec
DATABASE_SSL=false

# --- MikroTik RouterOS API ---
# Classic binary API, NOT the REST API — node-routeros speaks this protocol.
# Enable "api" service on the router: /ip service enable api  (port 8728, or
# 8729 for api-ssl — recommended for anything over the public internet).
ROUTEROS_HOST=203.0.113.10
ROUTEROS_PORT=8728
ROUTEROS_USER=admin
ROUTEROS_PASSWORD=change-this-password
ROUTEROS_TLS=false

# --- Webhook from the router's usage-push scheduler script ---
# Must match router-scripts/push-usage-webhook.rsc's $secret variable exactly.
WEBHOOK_SHARED_SECRET=change-this-to-a-long-random-string

# --- Paystack (self-service voucher purchase) ---
# Optional — leave blank to run without online payments; POST
# /api/payments/initialize returns a clear error until these are set.
# Get both from https://dashboard.paystack.co/#/settings/developer.
# After deploying, register https://<your-backend>/api/payments/webhook as
# the webhook URL in that same settings page.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
